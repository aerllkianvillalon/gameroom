{
  "name": "party-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @party/web",
    "build": "npm run build -w @party/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.48.0"
  }
}
