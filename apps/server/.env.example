# Port the server listens on (Render sets this automatically)
PORT=3001
HOST=0.0.0.0
# Comma-separated list of frontend origins allowed to connect, or * for any
ALLOWED_ORIGINS=http://localhost:5173
# Set to true only when a trusted reverse proxy (Render, Fly, nginx) sets X-Forwarded-For; otherwise players behind it share one IP
TRUST_PROXY=false
# Most simultaneous connections from one IP address
MAX_CONNECTIONS_PER_IP=20
